#
# Eksempel på afsender- og SMTP-opsætning til fskintra.
#
# Kopiér filen, ret værdierne til, og beskyt den - den kommer til at
# indeholde dit SMTP-kodeord i klartekst:
#
#     cp fskintra.env.example ~/.skoleintra/fskintra.env
#     chmod 600 ~/.skoleintra/fskintra.env
#
# Filen bruges direkte af Docker:
#
#     docker run --rm -v ~/.skoleintra:/root/.skoleintra \
#         --env-file ~/.skoleintra/fskintra.env \
#         ghcr.io/svalgaard/fskintra:master
#
# Uden Docker (fx. i et cron-script) indlæses den med:
#
#     set -a; . ~/.skoleintra/fskintra.env; set +a
#
# Bemærk: der sendes fra den SAMME afsenderadresse for alle profiler.
# Modtageradressen (email) sættes derimod per profil i konfigurationsfilen
# via 'fskintra.py --config'.
#

# Afsenderemailadresse. SKAL angives.
FSKINTRA_SENDER_EMAIL=example@example.net

# SMTP servernavn. Standard: localhost
FSKINTRA_SMTP_HOST=smtp.gmail.com

# SMTP serverport - fx 25 (localhost), 587 (gmail, tdc) eller 465 (SSL).
# Standard: 25
FSKINTRA_SMTP_PORT=587

# SMTP login. Udelad BEGGE linjer nedenfor hvis din SMTP server ikke
# kræver login (fx. en lokal server på localhost).
FSKINTRA_SMTP_USER=example@example.net
FSKINTRA_SMTP_PASSWORD=hemmeligt

# Login sendes kun krypteret (SSL/STARTTLS) og certifikatet tjekkes.
# Sæt kun til false ved en lokal server med selvsigneret certifikat.
# Standard: true
FSKINTRA_SMTP_VERIFY_SSL=true

# 'marker' gemmer kun en markering af at en mail er sendt, ikke en kopi af
# selve mailen i msg-kataloget. Standard: full
FSKINTRA_STORE_MESSAGES=full

#
# Valgfrit: "Nyt siden sidst" med AI-resumé og skoleoverblik i Home Assistant.
# Se docs/overblik.md. Udelad linjerne for at slå funktionerne fra.
#

# API-nøgle fra console.anthropic.com (separat fra et Claude.ai-abonnement).
# Tom = ingen AI; mails får stadig en regelbaseret "Nyt siden sidst"-boks.
FSKINTRA_ANTHROPIC_API_KEY=

# Claude-model. Standard: claude-opus-5-5. claude-haiku-5-5 er langt billigere.
FSKINTRA_AI_MODEL=claude-opus-5-5

# Home Assistant - URL og long-lived access token (Profil -> Sikkerhed).
# Tom = intet overblik i Home Assistant.
FSKINTRA_HA_URL=http://homeassistant.local:8123
FSKINTRA_HA_TOKEN=

# Sensor der viser overblikket. Standard: sensor.skoleintra_overblik
FSKINTRA_HA_ENTITY=sensor.skoleintra_overblik

# Lektier/afleveringer/medbring -> to-do, ture/ændrede tider -> kalender.
# Opret listerne i HA (Local To-do "Lektier", Local Calendar "Skole").
# 'off' slår synkroniseringen fra. Standard: todo.lektier / calendar.skole
FSKINTRA_HA_TODO=todo.lektier
FSKINTRA_HA_CALENDAR=calendar.skole

# Sæt til false hvis Home Assistant bruger et selvsigneret SSL-certifikat
# (eller du tilgår den via IP-adresse over https). Standard: true
FSKINTRA_HA_VERIFY_SSL=true

# Anbefalet: send skoleoverblikket via MQTT discovery i stedet for REST.
# Så er sensor.skoleintra_overblik en rigtig entitet, som Home Assistant
# genskaber med det samme efter en genstart (beskederne er retained).
# Kræver HA's MQTT-integration med discovery. Tom = REST som hidtil.
FSKINTRA_MQTT_HOST=
FSKINTRA_MQTT_PORT=1883
# Kun hvis brokeren kræver login
FSKINTRA_MQTT_USER=
FSKINTRA_MQTT_PASSWORD=
